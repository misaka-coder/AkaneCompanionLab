# One deployment environment file per named Akane instance.
# Example location used by akane@.service: /etc/akane/instances/finance-prod.env
# Never commit a filled copy.

RUN_MODE=CLOUD
AKANE_INSTANCE_ID=finance-prod
AKANE_DATA_ROOT=/var/lib/akane/finance-prod
HOST=127.0.0.1
PORT=10001

# Required for every named instance. Generate a distinct random value per
# instance and do not reuse the QQ webhook/OneBot tokens.
AKANE_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Optional: required only when a Desktop Satellite should offer local PC
# actions to this instance. Keep it distinct from admin, QQ, and model tokens.
AKANE_DESKTOP_SATELLITE_TOKEN=replace-with-a-long-random-device-token

# instance.toml remains authoritative for channels.qq.enabled/profile_ref.
# When that manifest channel is enabled, all values below are mandatory and
# QQ_CHANNEL_PROFILE_REF must match the manifest byte-for-byte.
QQ_CHANNEL_PROFILE_REF=finance-qq
QQ_BOT_QQ=replace-with-bot-qq-number
QQ_ONEBOT_HTTP_URL=http://127.0.0.1:3001
QQ_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
QQ_ONEBOT_ACCESS_TOKEN=replace-with-the-napcat-access-token
# Keep this equal to the existing owner's QQ number when migrating the
# local-default `master` memory identity to the cloud Bot.
MASTER_QQ=replace-with-owner-qq-number

# Persona. The named instance Manifest, not this env file, owns the selected
# character_pack_id.
PERSONA_VARIANT=default

# Embedding
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=

# Chat model
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL_NAME=
CHAT_API_PROTOCOL=auto

# Text / aux model
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_MODEL_NAME=deepseek-chat
TEXT_API_PROTOCOL=auto
AUX_API_KEY=
AUX_BASE_URL=
AUX_MODEL_NAME=deepseek-chat
AUX_API_PROTOCOL=auto

# Vision model
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL_NAME=
VISION_API_PROTOCOL=auto

# TTS
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+6%
TTS_VOLUME=+0%
TTS_PITCH=+4Hz
STREAMING_TTS_ENABLED=false

# Public web guard (quota remains per process and resets after restart)
PUBLIC_GUARD_ENABLED=false
MAX_CONCURRENT_THINKS=2
DAILY_THINK_LIMIT=200
PUBLIC_BUSY_MESSAGE=当前体验人数较多，请稍后再试。
PUBLIC_DAILY_LIMIT_MESSAGE=今日体验名额已满，明天再来看看 Akane 吧。
