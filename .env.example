# =============================================================================
# AkaneCompanionLab — .env 配置模板
# =============================================================================
# 使用方法：
#   普通本地用户：在桌面控制中心或 Web 设置中配置“模型服务”，无需编辑本文件。
#   服务器/高级用户：
#   1. 复制此文件为 .env ：  cp .env.example .env
#   2. 按需分别配置 CHAT / AUX / TEXT / VISION
#   3. 其余字段有默认值，可按需覆盖
#
# 标记说明：
#   [必填] = 不填会导致核心功能不可用
#   [建议] = 生产部署建议设置
#   无标记  = 有可用默认值，一般无需修改
# =============================================================================


# =============================================================================
# 1. 运行模式 & 网络
# =============================================================================

# 仅排查 Python 内存分配时开启；日常关闭，避免给每轮处理增加追踪开销。
RUNTIME_MEMORY_TRACING_ENABLED=false

# 运行模式：CLOUD=云端服务 LOCAL=本地模式
RUN_MODE=CLOUD

# 可选：从 AKANE_DATA_ROOT/instances/<id>/instance.toml 选择启动实例；留空保持本地兼容行为。
# named instance 还必须在 Python 启动前通过进程环境显式提供 AKANE_DATA_ROOT；
# 只把 AKANE_DATA_ROOT 写进项目 .env 太晚，不能建立可信的根绑定。生产环境请使用
# deploy/systemd/akane@.service.example 的每实例 EnvironmentFile。
AKANE_INSTANCE_ID=

# 可选：管理员信任的静态插件市场 index.json（HTTPS 地址或本地完整路径）。
# 留空读取仓库 .plugin-market/index.json；先运行 python scripts/build_plugin_market.py。
# 不要填含凭据或查询参数的 URL；市场不安装 FFmpeg 等系统依赖。
AKANE_PLUGIN_MARKET_INDEX=

# 插件依赖供应（二选一）：受信离线 wheelhouse 或允许的包索引。
# 外部运行依赖不会安装到 Akane 宿主环境，而会进入插件自己的隔离 staging。
AKANE_PLUGIN_DEPENDENCY_WHEELHOUSE=
AKANE_PLUGIN_DEPENDENCY_INDEX_URL=

# 插件调用结果注入给模型的单次预览字符上限（默认 16000）
AKANE_PLUGIN_RESULT_PREVIEW_CHARS=16000

# named instance 的管理写接口 token。每个实例独立生成，不与 QQ token 复用。
AKANE_ADMIN_TOKEN=

# Desktop Satellite 的实例级设备凭据。每个实例独立生成，不与管理、QQ 或模型 token 复用。
# 留空时后端不接受桌面执行器；本地一键启动会为 local-default 自动生成进程期凭据。
AKANE_DESKTOP_SATELLITE_TOKEN=

# 监听地址 & 端口
HOST=0.0.0.0
PORT=9999


# =============================================================================
# 2. LLM 密钥 & 接入（核心）
# =============================================================================
# AkaneCompanionLab 支持多协议 LLM 接入：OpenAI 兼容 / Anthropic / Ollama。
# 协议设为 "auto" 时会根据 base_url 自动探测。
#
# 键位角色：
#   TEXT  = 辅助任务（路由判断、记忆总结、时间解析等）
#   CHAT  = 聊天对话（缺失时回退到 TEXT）
#   AUX   = 额外辅助任务（缺失时回退到 TEXT）
#   VISION = 视觉/图像理解（缺失时回退到 CHAT → TEXT）
#
# 控制中心保存的本机模型配置优先于下面的 LLM 字段。
# 纯 .env 部署的最小配置：填写一个 TEXT_API_KEY 及对应地址/模型。

# --- TEXT（辅助任务）[必填，至少要有一个 key] ---
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_MODEL_NAME=deepseek-chat
TEXT_API_PROTOCOL=auto

# --- CHAT（聊天对话）---
# 不填 key/model 时回退到 TEXT 对应的值。
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL_NAME=
CHAT_API_PROTOCOL=auto
# DeepSeek 等 OpenAI 兼容模型的思考模式：disabled（默认关闭）/ enabled（开启）/ auto（自适应）
LLM_THINKING_MODE=disabled
# 聊天模型是否支持图片输入。默认 false（仅在未配置独立视觉模型且聊天模型支持看图时开启）
CHAT_SUPPORTS_IMAGES=false
# Responses API reasoning/privacy/context controls. Leave effort empty on
# Chat Completions providers; valid Responses values include low..max.
LLM_REASONING_EFFORT=
LLM_AUX_REASONING_EFFORT=
LLM_CHAT_REASONING_EFFORT=
LLM_DISABLE_RESPONSE_STORAGE=true
LLM_CONTEXT_WINDOW=0
LLM_AUTO_COMPACT_TOKEN_LIMIT=0
# 最终回复 Prompt 长度与哈希审计日志（排查 Prompt 结构用，不记录原文，日常关闭）
LLM_PROMPT_AUDIT_ENABLED=false
LLM_PROMPT_AUDIT_INCLUDE_AUX=false

# --- AUX（额外辅助）---
# 不填 key/model 时回退到 TEXT 对应的值。
AUX_API_KEY=
AUX_BASE_URL=
AUX_MODEL_NAME=
AUX_API_PROTOCOL=auto

# --- MEMCORE_SUMMARY（记忆摘要专用模型，可选）---
# 留空时自动回退使用 AUX / TEXT 的配置
MEMCORE_SUMMARY_API_KEY=
MEMCORE_SUMMARY_BASE_URL=
MEMCORE_SUMMARY_MODEL_NAME=
MEMCORE_SUMMARY_API_PROTOCOL=auto

# --- VISION（视觉/图像理解）---
VISION_ENABLED=true
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL_NAME=
VISION_API_PROTOCOL=auto
VISION_REQUEST_TIMEOUT=60
VISION_PROMPT_VERSION=v1
# 是否自动对场景/礼物/装扮触发视觉观察
VISION_AUTO_SCENE_OBSERVE=true
VISION_AUTO_GIFT_OBSERVE=true
VISION_AUTO_OUTFIT_OBSERVE=true
# 单张图片最大字节数（默认 8 MB）
VISION_MAX_IMAGE_BYTES=8388608

# --- 云端图片生成 / 编辑（PinAI GPT Image）---
# PinAI key 按平台分组；这里必须显式填写绑定 OpenAI 平台的图片 key，不能自动复用聊天 key。
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_BASE_URL=https://api.pinaic.com/v1
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_TIMEOUT_SECONDS=300
IMAGE_GENERATION_MAX_INPUT_IMAGES=5
IMAGE_GENERATION_MAX_OUTPUT_IMAGES=4
IMAGE_GENERATION_MAX_IMAGE_BYTES=8388608
IMAGE_GENERATION_MAX_TOTAL_INPUT_BYTES=20971520
IMAGE_GENERATION_MAX_OUTPUT_BYTES=26214400

# --- 本地 RVC 自动翻唱 ---
# V1 仅允许 localhost RVC WebUI；启动后需能访问 /config 与 /api/predict。
COVER_SONG_ENABLED=false
RVC_WEBUI_BASE_URL=http://127.0.0.1:7899
# 可选，用于把本地权重/index 的 size+mtime 纳入缓存指纹。
RVC_ROOT_DIR=
RVC_DEFAULT_MODEL=
COVER_SONG_SEPARATION_MODEL=HP5_only_main_vocal
COVER_SONG_DEFAULT_OUTPUT_FORMAT=mp3
# auto / voice / file / both / none；QQ 下 auto 会解析为 voice。
COVER_SONG_DEFAULT_DELIVERY=auto
COVER_SONG_TIMEOUT_SECONDS=1800
# 本地媒体宿主。普通分轨优先使用 Demucs；下面的 UVR 模型只作为回退和翻唱前处理。
WHISPER_CACHE_DIR=
AKANE_LOCAL_WHISPER_MODEL=small
AKANE_LOCAL_ASR_DEVICE=cpu
AKANE_LOCAL_ASR_COMPUTE_TYPE=int8
AKANE_LOCAL_RVC_SEPARATION_MODEL=HP5_only_main_vocal
COVER_SONG_MAX_DURATION_SECONDS=900
COVER_SONG_MAX_INPUT_BYTES=268435456

# --- 独立媒体执行器与在线歌词 ---
# 本地媒体控制服务（通过 Windows SMTC 发现和控制播放中媒体，留空关闭）
LOCAL_MEDIA_EXECUTOR_BASE_URL=
LOCAL_MEDIA_EXECUTOR_TIMEOUT_SECONDS=1800.0
# 在线歌词检索及提供者（逗号分隔，如 Lrclib,NetEase,Musixmatch,Megalobiz）
MUSIC_ONLINE_LYRICS_ENABLED=true
MUSIC_ONLINE_LYRICS_PROVIDERS=Lrclib,NetEase,Musixmatch,Megalobiz


# =============================================================================
# 3. 人设 & 提示词
# =============================================================================

# 自定义人设配置文件路径（TOML），留空使用内置 default。
PERSONA_CONFIG_PATH=

# 使用人设文件中的哪个 variant（对应 TOML 中 [variants.xxx]）
PERSONA_VARIANT=default


# =============================================================================
# 4. 向量记忆 & Embedding
# =============================================================================

# Embedding 提供者：auto | huggingface | remote | jina | hashed
# auto = 尝试本地 HuggingFace sentence-transformers，失败时回退到 hashed
# hashed = 纯本地哈希，无额外依赖，适合最小化部署
EMBEDDING_PROVIDER=auto

# 模型名或 HuggingFace 本地模型目录。
# HuggingFace/remote 可使用 BAAI/bge-m3；Jina 推荐 jina-embeddings-v3。
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# OpenAI-compatible 远程 Embedding（EMBEDDING_PROVIDER=remote/jina 时生效）。密钥不要提交。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30

# 设备：空=自动  cuda  cpu
EMBEDDING_DEVICE=

# 只使用本地缓存/本地模型目录，避免启动时联网下载；首次联网下载模型时可临时设为 false
EMBEDDING_LOCAL_FILES_ONLY=true

# HuggingFace/sentence-transformers 缓存目录（留空=默认缓存）
EMBEDDING_CACHE_FOLDER=

# 可选的 HuggingFace Hub 镜像地址；由 huggingface_hub / transformers 直接读取。
HF_ENDPOINT=

# Embedding 模型缓存大小
EMBEDDING_CACHE_SIZE=2048

# 重建索引时的批量大小
EMBEDDING_REINDEX_BATCH_SIZE=64

# 启用语义记忆（长期事实/话题抽取）
ENABLE_SEMANTIC_MEMORY=true

# 启用语义强化（跨会话话题追踪）
ENABLE_SEMANTIC_REINFORCEMENT=true


# =============================================================================
# 5. 记忆 & 检索调优
# =============================================================================

# 预检索默认开关
PRE_RETRIEVAL_DEFAULT_ENABLED=true

# "走神"概率——偶尔插入不相关检索，让回复更自然（0.0 ~ 1.0）
DRIFT_PROBABILITY=0.20

# 触发摘要的累积消息数
SUMMARY_TRIGGER_COUNT=30

# 摘要批处理大小
SUMMARY_BATCH_SIZE=20

# 情节记忆压缩触发阈值（条数）
EPISODIC_COMPACT_TRIGGER_COUNT=10

# 情节记忆压缩批处理大小
EPISODIC_COMPACT_BATCH_SIZE=5

# 可见情节记忆最大条数
EPISODIC_VISIBLE_MAX=10

# 可见语义记忆最大条数（过少=缺上下文，过多=prompt 太长）
SEMANTIC_VISIBLE_LIMIT=3

# 语义强化回溯窗口（跨会话）
SEMANTIC_REINFORCEMENT_LOOKBACK=8

# 语义强化最小重叠次数（低于此次数的主题不被强化）
SEMANTIC_REINFORCEMENT_MIN_OVERLAP=2

# 记忆后端：memcore=主路  legacy=旧系统兼容  dual=迁移/对比双写
MEMORY_BACKEND=memcore

# memcore SQLite 路径；留空时使用用户数据目录下的 memcore_v01.db
MEMCORE_STORAGE_PATH=

# memcore 可见长期记忆作用域：user=跨会话连续感  conversation=仅当前会话可见
MEMCORE_VISIBLE_SCOPE=user

# memcore 情绪/口吻温度层
MEMCORE_ENABLE_FLAVOR=true

# 影子检索对比；仅迁移排查时开启
MEMCORE_SHADOW_COMPARE=false

# 未摘要 raw provider projection 的 token 触发线，以及触发后计划压缩的旧 raw 比例
# 实际切点始终对齐完整 turn/relation component；SUMMARY_BATCH_SIZE 不截断 token 模式
MEMCORE_RAW_TOKEN_TRIGGER=48000
MEMCORE_RAW_TOKEN_BATCH_RATIO=0.67
MEMCORE_RETRIEVAL_RESULT_TOKEN_BUDGET=0
MEMCORE_NATIVE_TIMELINE_PAGE_TOKEN_BUDGET=12000
MEMCORE_COMPACTION_WORKERS=1
MEMCORE_LLM_TIMEOUT_SECONDS=55
MEMCORE_COMPACTION_FAILURE_COOLDOWN_SECONDS=60
# 记忆操作投影策略：full_until_raw_compaction（默认）/ compact_after_terminal
MEMCORE_OPERATION_PROJECTION_POLICY=full_until_raw_compaction


# =============================================================================
# 6. Prompt 缓存（减少首 token 延迟）
# =============================================================================

# 启用 prompt cache hints（需模型支持，DeepSeek 支持）
PROMPT_CACHE_HINTS_ENABLED=true

# 强制开启 cache hints（即使模型未在已知支持列表中）
PROMPT_CACHE_HINTS_FORCE=false

# 缓存命名空间（用于区分不同实例，避免 key 冲突）
PROMPT_CACHE_NAMESPACE=akane

# 缓存保留策略：空=服务默认，in-memory=短期，24h=最长 24 小时
PROMPT_CACHE_RETENTION=


# =============================================================================
# 7. 语音 (TTS)
# =============================================================================

# Edge TTS 语音角色
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 语速（相对百分比，如 "+6%" / "-10%"）
TTS_RATE=+6%

# 音量
TTS_VOLUME=+0%

# 音调
TTS_PITCH=+4Hz

# 流式 TTS（边生成边播放）
STREAMING_TTS_ENABLED=true

# GPT-SoVITS 外部 API 默认参数（保持保守；角色声线档案可覆盖部分字段）
GPT_SOVITS_TTS_TIMEOUT_SECONDS=45
GPT_SOVITS_TEXT_LANG=zh
GPT_SOVITS_MEDIA_TYPE=wav
GPT_SOVITS_STREAMING_MODE=false

# 可选推理调参：留空表示不传给 GPT-SoVITS，由外部 API 使用自己的默认值
# GPT_SOVITS_PARALLEL_INFER=true
# GPT_SOVITS_SPLIT_BUCKET=true
# GPT_SOVITS_BATCH_SIZE=1
# GPT_SOVITS_SPEED_FACTOR=1.0
# GPT_SOVITS_FRAGMENT_INTERVAL=0.1
# GPT_SOVITS_TEXT_SPLIT_METHOD=cut5

# VoiceCore 实时 ASR（默认关闭；当前不会替换既有 /asr 文件转写入口）
FUN_ASR_REALTIME_ENABLED=false
# 百炼 API Key，只放在实际 .env；不是阿里云 RAM AccessKey ID/Secret。
DASHSCOPE_API_KEY=
# 只填业务空间 API Host，例如：
# llm-xxxxxxxx.cn-beijing.maas.aliyuncs.com
DASHSCOPE_API_HOST=
FUN_ASR_REALTIME_MODEL=fun-asr-realtime
# VoiceCore 第一版统一发送 16 kHz 单声道 PCM；不能把 WebM 容器字节伪装成 PCM。
FUN_ASR_AUDIO_FORMAT=pcm
FUN_ASR_SAMPLE_RATE=16000
# Fun-ASR 句内 VAD 检查点；VoiceCore 的最终回合判定仍由宿主负责。
FUN_ASR_MAX_SENTENCE_SILENCE=800
# 可选：百炼 Fun-ASR 热词表 ID。
FUN_ASR_VOCABULARY_ID=


# =============================================================================
# 8. 公开访问保护 & 限流
# =============================================================================

# 启用公开访问保护（限制并发 & 每日总量）
PUBLIC_GUARD_ENABLED=false

# 最大并发 /think 请求数
MAX_CONCURRENT_THINKS=2

# 每日 /think 请求上限
DAILY_THINK_LIMIT=200

# 繁忙时的提示语
PUBLIC_BUSY_MESSAGE=当前体验人数较多，请稍后再试。

# 每日限额用尽时的提示语
PUBLIC_DAILY_LIMIT_MESSAGE=今日体验名额已满，明天再来看看吧。


# =============================================================================
# 9. 工具调用 & 后台任务
# =============================================================================

# 每批只读工具的实际并发数（1–64，默认10）；超额排队，不丢调用。
# 执行器与模型提示读取同一配置；修改后重启后端。不是后台任务/子代理数量上限。
TOOL_MAX_PARALLEL=10

# 可选的单回合工具批次硬上限；0=不限制，正数才启用；一次并行工具批次算一轮。
TOOL_ROUND_HARD_LIMIT=0

# 有限硬上限剩余这么多轮时向模型发送一次续作提醒；工具仍然可用，0=关闭提醒。
TOOL_ROUND_WARNING_REMAINING=8

# Provider 连续没有形成可表示决策时的生成次数；不消耗真实工具轮预算，
# 也不会改变本轮工具权限。带名称的工具调用会得到普通结构化结果，不进入此计数。
CHAT_MODEL_DECISION_MAX_ATTEMPTS=3

# provider native tool_calls 通道总开关。
# true = 当前场景 capability selection 选出的工具优先走 native schema；
# 不支持 native 的 provider 才回退 legacy JSON tool_call。
# false = 显式关闭 native，所有工具走 legacy 兼容路径。
ENABLE_NATIVE_TOOL_DECISION=true

# native tool 允许列表，逗号分隔。默认值见 config.py。
# 这只是”候选清单”，是否真的启用仍取决于 ENABLE_NATIVE_TOOL_DECISION。
# "*" means every tool selected for the current client/scenario. Use a comma-separated
# list only for an intentionally restricted profile. Providers without native tool
# support still use the legacy JSON compatibility path.
NATIVE_TOOL_DECISION_ALLOWLIST=*

# 兼容过渡项：未保存工具呈现首选项时，是否将工具默认呈现映射为 on_demand（默认 false）
ENABLE_PROGRESSIVE_CAPABILITY_DISCOVERY=false

# AnySearch MCP 单次调用超时（秒）。时间范围 batch_search 往往比单查询更慢。
WEB_SEARCH_MCP_TIMEOUT_SECONDS=35

# Akane 唯一可访问的文件工作区。留空时默认创建在桌面的 Akane Workspace。
# 建议填写绝对路径，例如 D:\Akane Workspace
AKANE_WORKSPACE_ROOT=

# 单个工作区文件允许直接读取的最大字节数（默认 64 MB）。
AKANE_WORKSPACE_MAX_READ_BYTES=67108864

# 后台任务默认并发 Worker 数
BACKGROUND_DEFAULT_WORKERS=1

# 后台附件处理并发 Worker 数
BACKGROUND_ATTACHMENT_WORKERS=3


# =============================================================================
# 10. 调试开关
# =============================================================================
# 默认全部关闭。开启后 /think 流会在日志中输出详细 JSON。

ROUTER_DEBUG=false
VERIFIER_DEBUG=false
FINAL_DEBUG=false


# =============================================================================
# 11. 远程媒体 (yt-dlp)
# =============================================================================

# Cookie 文件路径（用于下载需登录的平台内容）
REMOTE_MEDIA_YTDLP_COOKIEFILE=

# 自定义 User-Agent
REMOTE_MEDIA_YTDLP_USER_AGENT=

# Referer 头（默认指向 bilibili）
REMOTE_MEDIA_YTDLP_REFERER=https://www.bilibili.com/


# =============================================================================
# 12. 可选的独立 Choice EmQuant Bridge 服务
# =============================================================================

# 这些键只由 services/emquant_bridge 读取，不进入 Akane 主宿主 Settings。
# 金融问答、订阅与 QQ 推送属于可选插件，不在主宿主 .env 中配置。
EMQUANT_ENABLED=false
EMQUANT_API_ROOT=
EMQUANT_BRIDGE_HOST=127.0.0.1
EMQUANT_BRIDGE_PORT=9910
EMQUANT_SUBSCRIPTION_STATE_PATH=
EMQUANT_CALLBACK_QUEUE_MAX=5000


# =============================================================================
# 13. QQ / NapCat 桥接
# =============================================================================
# 需要先部署 NapCat（OneBot HTTP 协议）才能使用 QQ 相关功能。
# local-default 使用 QQ_BRIDGE_ENABLED；named instance 由 instance.toml 的
# [channels.qq] enabled/profile_ref 决定，manifest 不存任何 secret。

# 总开关
QQ_BRIDGE_ENABLED=false

# 部署侧通道引用；named instance 开启 QQ 时必须与 manifest 完全一致
QQ_CHANNEL_PROFILE_REF=

# OneBot HTTP 服务地址
QQ_ONEBOT_HTTP_URL=http://127.0.0.1:3001
# 可选：允许读取的 NapCat/OneBot 缓存根目录，多个目录用分号分隔。留空时不读取本地 cache path。
QQ_ONEBOT_CACHE_ROOTS=

# Bot 自己的 QQ 号；named instance 开启 QQ 时必填且一个 Bot 只能绑定一个实例
QQ_BOT_QQ=

# NapCat 反向 HTTP webhook Bearer secret；named instance 开启 QQ 时必填
QQ_WEBHOOK_SECRET=

# Akane 调用 OneBot HTTP API 的 access token；named instance 开启 QQ 时必填
QQ_ONEBOT_ACCESS_TOKEN=

# QQ 文字聊天默认使用的 Creator Kit 角色包 id，留空则使用内置 Akane 人设
QQ_CHARACTER_PACK_ID=

# QQ 回复投递模式：text | voice | both | auto
# auto 下模型只能通过 QQ 专属 reply_medium 表达偏好，后端仍会做长度/TTS/发送失败兜底
QQ_REPLY_MODE=auto
# 每回合即时推送的流式文字气泡数；0=不限，正数才在超出后于回合结束时无损合并补发
QQ_STREAM_IMMEDIATE_SEGMENTS=0

# QQ 语音合成读取哪份本地能力配置；留空则使用 WEB_OWNER_PROFILE_USER_ID/master
# 如需恢复按当前 QQ 会话各自读取能力配置，可填 conversation
QQ_TTS_PROFILE_USER_ID=

# QQ 联网搜索读取哪份本地能力配置；留空则使用 WEB_OWNER_PROFILE_USER_ID/master
# 如需恢复按当前 QQ 会话各自读取 AnySearch/MCP 配置，可填 conversation
QQ_WEB_SEARCH_PROFILE_USER_ID=

# QQ 语音回复最大合成文本长度，超过后降级为文字
QQ_VOICE_MAX_TEXT_CHARS=280

# QQ 语音回复最多合成的 speech segment 数
QQ_VOICE_MAX_SEGMENTS=3

# 允许在群聊中使用明文（非 JSON 卡片）模式
QQ_GROUP_PLAINTEXT_ENABLED=false

# 未触发 Bot 的群消息记忆策略：all / allowlist / denylist / off
QQ_GROUP_PASSIVE_MEMORY_MODE=all

# allowlist / denylist 使用的群号，支持逗号、分号或空白分隔
QQ_GROUP_PASSIVE_MEMORY_GROUP_IDS=

# 普通群消息注意力模式：off / engaged / adaptive；不影响 @、唤醒词和回复 Akane
QQ_GROUP_ATTENTION_MODE=engaged

# Akane 成功参与后普通消息可继续触发判断的活跃窗口（秒）
QQ_GROUP_ATTENTION_TTL_SECONDS=120

# 普通消息触发一次注意力判断前的固定等待（秒）；后续消息不会重置倒计时
QQ_GROUP_ATTENTION_DELAY_SECONDS=10

# adaptive 模式非活跃观察后的冷却（秒）
QQ_GROUP_ATTENTION_IDLE_COOLDOWN_SECONDS=60

# 附件去抖间隔（秒），同一消息的多次事件合并
QQ_ATTACHMENT_DEBOUNCE_SECONDS=1.2

# 附件就绪等待时间（秒），普通文件按这里等待；QQ 图片会自动等到 VISION_REQUEST_TIMEOUT + 5
QQ_ATTACHMENT_READY_WAIT_SECONDS=8.0

# 多消息段之间的发送间隔（秒）
QQ_REPLY_SEGMENT_DELAY_SECONDS=0.8

# 事件最大有效时间（秒），超过此时间的延迟事件丢弃
QQ_EVENT_MAX_AGE_SECONDS=300

# 允许处理过期事件
QQ_ALLOW_STALE_EVENTS=false

# 附件下载超时（秒）
QQ_ATTACHMENT_DOWNLOAD_TIMEOUT=20.0

# 附件下载最大字节数（默认 64 MB，仍保留单文件保护）
QQ_ATTACHMENT_MAX_BYTES=67108864

# QQ 文本消息附件最大读取字节数（默认 256 KB）
QQ_TEXT_ATTACHMENT_MAX_READ_BYTES=262144

# QQ 附件首次物化失败时，私有重试定位信息最多保留秒数（默认 7 天）
QQ_ATTACHMENT_SOURCE_LOCATOR_TTL_SECONDS=604800

# 外部公网 URL DNS 解析回退机制（默认开启）
PUBLIC_URL_DNS_FALLBACK_ENABLED=true


# =============================================================================
# 14. Web 身份模式
# =============================================================================
# owner  : 本地主创模式，所有浏览器共享同一主人 profile。
# browser: 每个浏览器分配独立匿名 profile，适合公开试玩。
# invite : 通过 URL 邀请码映射 profile，适合小范围闭测。

WEB_IDENTITY_MODE=owner

# owner 模式下使用的 profile 标识
WEB_OWNER_PROFILE_USER_ID=master


# =============================================================================
# 15. 本地通用执行（TrustedLocalExecutor）
# =============================================================================
# 默认全部关闭：未启用时 exec_run/exec_status/exec_cancel 完全不进入模型 schema。
# EXECUTION_ENABLED=true 后，桌宠本机模式下模型可以以宿主用户权限在受信任工作区
# 执行命令；不是 OS 沙箱。
EXECUTION_ENABLED=false
# QQ Shell 宿主总闸。默认关闭；开启后仍需主人在目标私聊或群聊发送 /shell on。
# 命令始终运行在 QQ Bot 后端所在机器，不会隐式访问聊天成员的个人电脑；只有
# MASTER_QQ 能调节会话权限，每个私聊/群聊默认关闭且彼此隔离。
EXECUTION_QQ_ENABLED=false
BROWSER_PAGE_PRIVATE_NETWORK_ACCESS=false
# 无桌面的服务器可设为 true；Windows 本地默认 false，保留用户可见窗口。
BROWSER_PAGE_HEADLESS=false
# 命令 cwd 根目录；留空= DATA_ROOT/execution_workspace
EXECUTION_WORKSPACE_ROOT=
# 完整输出日志目录；留空= STATE_DIR/execution_runlogs
EXECUTION_RUN_LOG_DIR=
# 可选受限模式：仅继承这些宿主环境变量名，逗号分隔。
# 留空（推荐）=继承普通宿主环境与 PATH，同时移除凭据类名称和 AKANE_* 内部变量。
EXECUTION_ALLOWED_ENV_NAMES=
# 可选：显式允许受信任执行器使用的凭据环境变量名，逗号分隔；这里只写名称，值仍放在宿主环境。
# 例：GITHUB_TOKEN,NPM_TOKEN。模型只看到引用名；命令输出与 run log 会按实际值精确遮蔽。
EXECUTION_CREDENTIAL_ENV_NAMES=
# 可选 HTTP 代理；只有端到端 CONNECT 探测成功时才注入 Shell，失败则自动直连。
# 推荐仅指向宿主回环地址，不要放入带账号密码的 URL。
EXECUTION_PROXY_URL=

# 启动级执行资源策略与规则集 JSON（高级部署项，默认空）
AKANE_EXECUTION_RESOURCE_POLICY={}
AKANE_EXECUTION_POLICIES=[]


# =============================================================================
# 16. 其他
# =============================================================================

# 主人 QQ 号；由使用者自行填写，留空时私聊使用独立 QQ 身份
MASTER_QQ=
