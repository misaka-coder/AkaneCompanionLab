{
  "name": "akane-desktop-pet-next",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Tauri/WebView2 prototype shell for Akane desktop pet.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "doctor": "node ./scripts/doctor.mjs",
    "build": "vite build",
    "smoke:care-feature": "node ./scripts/care-feature-smoke.mjs",
    "smoke:instance-storage": "node ./scripts/instance-storage-smoke.mjs",
    "smoke:speech-delivery": "node ./scripts/speech-delivery-smoke.mjs",
    "smoke:bubble-delivery": "node ./scripts/bubble-delivery-smoke.mjs",
    "smoke:screen-observation": "node ./scripts/screen-observation-smoke.mjs",
    "smoke:desktop-perception": "node ./scripts/desktop-perception-retirement-smoke.mjs",
    "smoke:realtime-voice": "node ./scripts/realtime-voice-smoke.mjs",
    "smoke:voice-endpoint": "node ./scripts/realtime-voice-endpoint-smoke.mjs",
    "smoke:tts-presentation": "node ./scripts/tts-presentation-smoke.mjs",
    "smoke:voice-capture": "node ./scripts/voice-capture-smoke.mjs",
    "smoke:voice-call": "node ./scripts/realtime-voice-call-flow-smoke.mjs",
    "smoke:voice-interruption": "node ./scripts/realtime-voice-interruption-smoke.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "start:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-next.ps1",
    "smoke:control-center-actions": "node ./scripts/control-center-action-bridge-smoke.mjs",
    "smoke:control-center-v2": "node ./scripts/control-center-v2-smoke.mjs",
    "probe:control-center-runtime": "node ./scripts/control-center-runtime-probe.mjs",
    "smoke:control-center-ux": "node ./scripts/control-center-ux-smoke.mjs",
    "verify:control-center": "node ./scripts/control-center-verify.mjs",
    "dev:control-center": "npm run tauri -- dev",
    "dev:control-center-v2": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-control-center-v2.ps1",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri-with-cargo-path.ps1",
    "scene:contracts": "node scripts/scene-contracts.mjs",
    "scene:check": "node scripts/scene-contracts.mjs --check && node scripts/scene-boundaries.mjs && vue-tsc --project tsconfig.scene.json --noEmit",
    "scene:test": "vitest run src/scene"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "ajv": "8.20.0",
    "pinia": "3.0.4",
    "pixi.js": "8.21.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
