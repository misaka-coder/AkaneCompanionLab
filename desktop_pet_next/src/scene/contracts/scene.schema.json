{
  "$defs": {
    "ActionRequest": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "request_id": {
          "maxLength": 100,
          "minLength": 8,
          "title": "Request Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "equip",
            "background",
            "music",
            "position",
            "buy",
            "feed",
            "touch",
            "claim_allowance"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "default": "",
          "maxLength": 120,
          "title": "Target",
          "type": "string"
        },
        "count": {
          "default": 1,
          "maximum": 999,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "identity",
        "request_id",
        "expected_revision",
        "kind",
        "target",
        "count"
      ],
      "title": "ActionRequest",
      "type": "object"
    },
    "ActionResult": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "duplicate": {
          "default": false,
          "title": "Duplicate",
          "type": "boolean"
        },
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        }
      },
      "required": [
        "ok",
        "reason",
        "duplicate",
        "event",
        "snapshot"
      ],
      "title": "ActionResult",
      "type": "object"
    },
