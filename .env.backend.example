# CPU-only API backend. Configure the chat provider before sending a turn.
HOST=127.0.0.1
PORT=9999
CHAT_API_PROTOCOL=openai
CHAT_API_KEY=
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL_NAME=

# Navigation reads persisted memory without a local embedding model.
MEMCORE_RETRIEVAL_MODE=navigation
QQ_BRIDGE_ENABLED=false

# Optional: choose an absolute persistent data directory outside the checkout.
# AKANE_DATA_ROOT=
