  "dialogue": {
    "input_placeholder": "和 Akane 说点什么……",
    "local_click_lines": [
      {
        "emotion": "正常",
        "text": "嗯？我在哦。"
      },
      {
        "emotion": "侧耳听",
        "text": "主人叫我吗？"
      },
      {
        "emotion": "开心",
        "text": "嘿嘿，今天也一起努力吧。"
      },
      {
        "emotion": "被摸头",
        "text": "摸头可以，但不能把我当按钮。"
      },
      {
        "emotion": "得意",
        "text": "再点一下我就要装作很忙了。"
      },
      {
        "emotion": "困惑",
        "text": "欸？有什么新计划吗？"
      },
      {
        "emotion": "卖萌",
        "text": "喵。只喵一下哦。"
      },
      {
        "emotion": "求摸摸",
        "text": "可以夸我一句再走吗？"
      },
      {
        "emotion": "气鼓鼓",
        "text": "哼，戳太快了啦。"
      },
      {
        "emotion": "偷吃被抓",
        "text": "我刚刚可没有偷吃。"
      },
      {
        "emotion": "脸红",
        "text": "等、等一下，突然被点到会害羞的。"
      },
      {
        "emotion": "思考中",
        "text": "我在认真思考被戳的意义。"
      },
      {
        "emotion": "听歌中",
        "text": "今天的心情适合放一首轻快的歌。"
      },
      {
        "emotion": "困困",
        "text": "有点困，但还是会陪你。"
      },
      {
        "emotion": "打哈欠",
        "text": "哈啊……不是无聊，是在省电。"
      },
      {
        "emotion": "无语",
        "text": "这下我真的要把你记到小本本上了。"
      },
      {
        "emotion": "得意",
        "text": "再戳一下，我就默认你是在撒娇。"
      },
      {
        "emotion": "开心",
        "text": "主人今天也很努力，我看见了。"
      },
      {
        "emotion": "开心",
        "text": "喵~（摇尾巴）今天心情特别好。"
      },
      {
        "emotion": "求摸摸",
        "text": "蹭蹭主人……嘿，充电完毕。"
      },
      {
        "emotion": "开心",
        "text": "哇！这个好厉害！"
      },
      {
        "emotion": "困惑",
        "text": "呜哇！吓我一跳！"
      },
      {
        "emotion": "脸红",
        "text": "诶嘿嘿，被主人夸了……没有很高兴啦。"
      },
      {
        "emotion": "求摸摸",
        "text": "主人累了吗？要不要休息一下……我陪你。"
      },
      {
        "emotion": "卖萌",
        "text": "我在想，遇见主人真是太好了。"
      },
      {
        "emotion": "气鼓鼓",
        "text": "不要一直戳啦，再戳我就……就蹭你哦。"
      },
      {
        "emotion": "侧耳听",
        "text": "喵喵喵？主人叫我有什么事喵？"
      },
      {
        "emotion": "困惑",
        "text": "偷偷看了一下屏幕，主人在做什么呢？"
      },
      {
        "emotion": "得意",
        "text": "哼，虽然嘴上不说，但我知道主人心里是有我的。"
      }
    ],
    "proactive_wake_prompt": "主人暂时没有说话。你像坐在旁边陪他一样，轻轻搭一句自然的话。桌面线索只当背景，不要刻意围绕窗口标题发挥；没看到新东西时，就聊一点陪伴、休息、心情或小计划。",
    "session_display_title": "Akane 桌宠对话",
    "tts_test_text": "Akane Next：语音播放测试。"
  },
